# Copy to .env.local and fill in what you have. Everything is optional: the app runs fully self-hosted without tokens.

# Cesium ion access token (https://ion.cesium.com/tokens). Enables Cesium World Terrain + Cesium OSM Buildings as
# an optional reference/prototype layer. NOT required. Never commit a real token.
VITE_CESIUM_ION_TOKEN=

# Base imagery: gibs | carto-dark | carto-light | osm | custom | ion-bing | none
#   gibs     : NASA GIBS Blue Marble (+ Black Marble city lights at night). Keyless, public domain, ~600 m/px:
#              fine for the globe/region view; at city scale the self-hosted vector layers carry the picture. (default)
#   carto-*  : CARTO raster basemaps — now REQUIRE an API key (VITE_CARTO_API_KEY); check CARTO terms for commercial use
#   osm      : tile.openstreetmap.org (dev only! OSMF tile usage policy forbids heavy/production use)
#   custom   : any XYZ template via VITE_IMAGERY_URL (e.g. your own MapTiler/Stadia key or self-hosted tiles)
#   ion-bing : Bing Maps aerial via Cesium ion (needs VITE_CESIUM_ION_TOKEN)
#   none     : plain dark globe, only self-hosted vector layers (fully self-contained / offline-capable)
VITE_IMAGERY=gibs
VITE_CARTO_API_KEY=
VITE_IMAGERY_URL=
VITE_IMAGERY_ATTRIBUTION=

# Terrain: ellipsoid | ion | local
#   ellipsoid : flat WGS84 ellipsoid (default; Shanghai is nearly flat)
#   ion       : Cesium World Terrain (needs token)
#   local     : self-hosted quantized-mesh terrain in public/terrain/shanghai (see scripts/process-dem)
VITE_TERRAIN=ellipsoid

# Buildings: local | ion | both
#   local : self-hosted 3D Tiles produced by scripts/process-buildings (public/tiles/buildings/tileset.json)
#   ion   : Cesium OSM Buildings (ion asset 96188, needs token) — reference/prototype only
VITE_BUILDINGS=local

# Base URL for large static data (tiles/terrain/models). Empty = same origin (public/). Use an R2/S3/CDN URL in prod.
VITE_DATA_BASE_URL=
