{
  "name": "shanghai-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "data:download": "tsx scripts/download-osm/download.ts",
    "data:geojson": "tsx scripts/process-geojson/process.ts",
    "data:landmarks": "tsx scripts/build-landmarks/build-landmarks.ts",
    "data:buildings": "node --max-old-space-size=8192 --import tsx scripts/process-buildings/build-shanghai-buildings.ts",
    "data:validate": "tsx scripts/validate-data/validate.ts",
    "data:all": "npm run data:download && npm run data:geojson && npm run data:extract && npm run data:pbf && npm run data:overture && npm run data:cnbh && npm run data:landmarks && npm run data:buildings:city && npm run data:validate",
    "data:pbf": "tsx scripts/process-geojson/process-pbf.ts",
    "data:extract": "./scripts/download-osm/extract-pbf.sh",
    "data:buildings:city": "node --max-old-space-size=20000 --import tsx scripts/process-buildings/build-shanghai-buildings.ts --input=data/raw/pbf",
    "data:overture": "./scripts/download-osm/download-overture.sh",
    "data:cnbh": "./scripts/download-osm/download-cnbh.sh"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@turf/turf": "^7.4.0",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "earcut": "^3.2.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "geotiff": "^3.0.5",
    "globals": "^17.12.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "osmtogeojson": "^3.0.0-beta.5",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
